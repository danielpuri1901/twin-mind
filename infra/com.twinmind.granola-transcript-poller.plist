<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Granola transcript ingest poller - Mac-side LaunchAgent, every 15 min.
  MUST be a LaunchAgent (per-user, GUI session), not a LaunchDaemon: the poller
  reads the login Keychain ("Granola Safe Storage") to decrypt the local token,
  which only the user's GUI session can do.

  Install (copy into LaunchAgents, then load) - Daniel runs this himself:
    cp "/Users/danielpuri/Super Project/infra/com.twinmind.granola-transcript-poller.plist" ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.twinmind.granola-transcript-poller.plist

  First run pops the macOS Keychain prompt once - click "Always Allow" so future
  background runs read the key non-interactively. RunAtLoad fires immediately, which
  seeds the baseline (marks existing meetings seen; only new meetings are ingested).

  Uninstall:
    launchctl bootout gui/$(id -u)/com.twinmind.granola-transcript-poller
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.twinmind.granola-transcript-poller</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/danielpuri/.hermes/hermes-agent/venv/bin/python</string>
    <string>/Users/danielpuri/Super Project/pipeline/fetch_granola.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/danielpuri/Super Project</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/danielpuri</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/Users/danielpuri/.hermes/logs/granola-poller.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/danielpuri/.hermes/logs/granola-poller.err.log</string>
</dict>
</plist>
