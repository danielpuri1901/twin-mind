{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CohereEmbeddingsAndRerankOnly",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": [
        "arn:aws:bedrock:eu-west-1::foundation-model/cohere.embed-multilingual-v3",
        "arn:aws:bedrock:eu-central-1::foundation-model/amazon.rerank-v1:0"
      ]
    },
    {
      "Sid": "RerankApi",
      "Effect": "Allow",
      "Action": "bedrock:Rerank",
      "Resource": "*"
    }
  ]
}
