# Copy this file to .env, then replace each placeholder you need.

TWIN_SMTP_ADDRESS=you@example.com
TWIN_SMTP_APP_PASSWORD=replace-me
ALERT_EMAIL=you@example.com
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_HOME_CHANNEL=123456789

LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me
LANGSMITH_API_KEY=replace-me
LANGSMITH_PROJECT=twin-mind

TAVILY_API_KEY=replace-me
TWIN_TASK_MODEL=eu.anthropic.claude-sonnet-4-6
TWIN_CORPUS=/path/to/twin-corpus
TWIN_CALENDAR_ICS_URL=https://example.com/private-calendar.ics

# AWS identifiers (private, not secret): cost routing + the read-only audit in infra/check_aws.py
TWIN_BEDROCK_PROFILE_ARN=arn:aws:bedrock:eu-west-1:111122223333:application-inference-profile/replace-me
TWIN_AWS_ACCOUNT_ID=111122223333
